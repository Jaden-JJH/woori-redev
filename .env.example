# 로컬 개발용 환경변수. 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.
DATABASE_URL=postgresql://woori:woori@localhost:54329/woori

# LLM (없으면 녹화 응답 모드로 동작). 셸의 공용 ANTHROPIC_API_KEY 와 섞이지 않도록 앱 전용 이름을 쓴다.
WOORI_ANTHROPIC_API_KEY=
WOORI_GEMINI_API_KEY=

# 국가법령정보 공동활용 API 이용자 식별값 (https://open.law.go.kr)
LAW_API_OC=

# 선택
# CLAUDE_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-2.5-flash
# ADMIN_TOKEN=
